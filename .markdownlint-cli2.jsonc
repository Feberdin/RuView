{
  // Purpose: Check Markdown structure while accepting long tables, URLs, and
  // the repository's intentional HTML disclosure/layout elements.
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["a", "br", "details", "div", "em", "img", "p", "picture", "source", "strong", "sub", "summary"]
    }
  }
}
